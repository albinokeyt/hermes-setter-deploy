# === Obligatorias ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes
REDIS_URL=redis://localhost:6379

# Usuario inicial del panel (solo se usa la primera vez, luego se gestiona desde la seccion Usuario)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame

# URL publica de la app (la que te da EasyPanel), sin barra final.
# Se usa para construir la redirect URL del OAuth de GHL y las URLs de webhook.
APP_BASE_URL=https://hermes.tudominio.com

# === Opcionales ===
PORT=3000
# La firma de los webhooks de marketplace se verifica SIEMPRE con las claves oficiales
# de GHL que van incluidas en el codigo. Solo toca esto si GHL rota su clave Ed25519:
GHL_WEBHOOK_PUBLIC_KEY=
# Ultimo recurso si una rotacion de claves rompe la verificacion (NO recomendado):
ALLOW_UNSIGNED_WEBHOOKS=false
