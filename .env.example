# === Obligatorias ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes
REDIS_URL=redis://localhost:6379

# Usuario inicial del panel (solo se usa la primera vez, luego se gestiona desde la seccion Usuario)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame

# URL publica de la app (la que te da EasyPanel), sin barra final.
# Se usa para construir la redirect URL del OAuth de GHL y las URLs de webhook.
APP_BASE_URL=https://hermes.tudominio.com

# === Opcionales ===
PORT=3000
# La firma de los webhooks de marketplace se verifica SIEMPRE con las claves oficiales
# de GHL que van incluidas en el codigo. Solo toca esto si GHL rota su clave Ed25519:
GHL_WEBHOOK_PUBLIC_KEY=
# Ultimo recurso si una rotacion de claves rompe la verificacion (NO recomendado):
ALLOW_UNSIGNED_WEBHOOKS=false

# === Marketplace Disruptivo (accesos y cobros) ===
# SIN MD_API_KEY toda la integracion queda APAGADA: Hermes funciona como siempre, sin puerta de
# acceso y sin cobrar. Con la clave puesta: pregunta si el cliente tiene el uso incluido y, si no,
# le cobra su consumo del saldo del marketplace (credito interno primero, wallet de GHL despues).
# La clave la da el administrador del marketplace y solo se ve una vez. NUNCA en el repositorio.
MD_API_KEY=
MD_BASE_URL=https://marketplace.escaladoacelerado.es
# Tarifa (meter) contra la que se cobra. Dinamica, entre 0.01 y 100 USD por unidad.
MD_METER=consumo-apps
# Unidad facturable = UNA CONVERSACION POR DIA NATURAL (da igual cuantos mensajes se crucen).
MD_PRECIO_UNIDAD=0.25
MD_UNIDADES_POR_COBRO=1
# Zona con la que se decide el "dia natural". Forma parte del event_id: NO la cambies en caliente
# (una conversacion podria contarse dos veces el dia del cambio).
MD_ZONA_HORARIA=UTC
# Ponlo en false para desplegar con la puerta de acceso activa pero SIN cobrar todavia (observacion).
MD_COBROS=true
